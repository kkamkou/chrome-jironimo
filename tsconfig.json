{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"],
    "outDir": "./.out-tsc",
    "rootDir": "./src"
  },
  "include": ["src/app/**/*.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "compilationMode": "full"
  }
}
