{
  "name": "jironimo for JIRA",
  "version": "7.0.1",
  "manifest_version": 3,
  "offline_enabled": false,
  "homepage_url": "https://github.com/kkamkou/chrome-jironimo",
  "description": "Track Atlassian JIRA issues, run JQL workspaces, switch statuses, and log work time right from your browser toolbar.",
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "views/default.html#/settings/general",
  "minimum_chrome_version": "130",
  "icons": {
    "16": "icons/app-16.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "action": {
    "default_icon": "icons/app-128.png",
    "default_popup": "views/default.html"
  },
  "background": {
    "service_worker": "app/bootstrap-bg.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+J", "mac": "Command+J"},
      "description": "Open jironimo window"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ]
}
